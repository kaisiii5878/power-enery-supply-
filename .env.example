# ---------------------------------------------------------------------------
# PowerWatch Cameroon — environment template
#
# Copy to `.env` and fill in. `.env` is git-ignored: never commit real
# credentials, database passwords or API secrets.
# ---------------------------------------------------------------------------

# ---- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Storage engine: auto | postgres | mysql | memory
#   auto     PostgreSQL when reachable, then MySQL, then the in-memory store
#   postgres PostgreSQL + PostGIS — the authoritative MVP database
#   memory   no database at all (demo, CI, unit tests)
STORAGE_DRIVER=auto

# Apply pending migrations on boot when the database is reachable.
DB_BOOTSTRAP=true

# ---- PostgreSQL + PostGIS (authoritative) ---------------------------------
# Either provide DATABASE_URL (managed hosts inject this) or the PG_* variables.
# DATABASE_URL=postgres://user:password@host:5432/powerwatch
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=powerwatch
# Managed Postgres usually requires TLS; local installs usually do not.
PGSSL=false
PG_POOL_MAX=10

# ---- MySQL (optional compatibility engine) --------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=eneo_outage
CLUSTER_DISTANCE_M=500
CLUSTER_WINDOW_MINUTES=30
MIN_REPORTS_TO_QUALIFY=1

# Coordinates are rounded to this many decimals before they leave the server
# towards citizens, so a public map shows an area rather than an address.
LOCATION_PRECISION_DP=3

# ---- Authentication -------------------------------------------------------
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_ISSUER=powerwatch
SESSION_TTL_MINUTES=480

# ---- Seeded administrator (created on first boot) -------------------------
# ADMIN_PASSWORD is required: the application never ships a fixed password.
ADMIN_USERNAME=console.admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=SOCADEL Administrator
ADMIN_EMAIL=console@powerwatch.example

# Password given to the simulated demo accounts created by `npm run seed`.
# Leave empty to have a random one generated and printed once.
SEED_DEMO_PASSWORD=

# ---- CORS -----------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:4173,http://localhost:4000

# ---- Optional integrations (the app degrades gracefully when unset) -------
GEMINI_API_KEY=
FCM_SERVER_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# ---- Client (Vite) --------------------------------------------------------
VITE_API_BASE=http://localhost:4000/api

